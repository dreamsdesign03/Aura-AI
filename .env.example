# Aura AI Environment Variables

# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Server
PORT=5000
NODE_ENV=production

# Admin (seeded on startup)
ADMIN_USERNAME=auraadmin
ADMIN_PASSWORD=Vishnu@Krishna
ADMIN_EMAIL=krishadmin@auraai.app

# WhatsApp / Meta
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=1293553613852388
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=aura_ai_secure_verify_token
WHATSAPP_N8N_WEBHOOK_URL=https://your-n8n-domain/webhook/whatsapp

# N8N Integration - API key for n8n to log outbound WhatsApp messages to the Clinic Inbox
N8N_LOG_KEY=your_secure_random_key_here

# Sarvam AI (Voice)
SARVAM_API_KEY=your_sarvam_api_key

# Plivo (Telephony)
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_CALLER_ID=+1xxxxxxxxxx

# SMTP (Email)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=Backoffice@auralaserclinic.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Backoffice@auralaserclinic.com
SMTP_FROM_NAME=Aura Laser & Cosmetic Clinic

# Cal.com (Booking)
CAL_API_KEY=your_cal_api_key
CAL_BOOKING_URL=https://cal.com/aura-laser-cosmetic-clinic/30min

# Google / Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Visibility Audit (SERP & AI Presence)
SERPER_API_KEY=your_serper_api_key
OPENAI_API_KEY=your_openai_api_key

# HubSpot
HUBSPOT_API_KEY=your_hubspot_api_key
HUBSPOT_PORTAL_ID=your_portal_id

# Security
CRON_SECRET=your_cron_secret_for_scheduled_tasks